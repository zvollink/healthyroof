---
// src/layouts/Layout.astro
import Nav from '../components/Nav.tsx';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Healthy Roof — Here, Roofs Last Longer",
  description = "Thoughtful roof care, clear guidance, and long-term solutions for homeowners across West Michigan. Schedule your Roof Health Assessment today.",
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" data-theme="healthyroof">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/images/hr-logo-turquoise.png" />
    <title>{title}</title>

    <!-- Adobe Fonts: Futura PT -->
    <link rel="stylesheet" href="https://use.typekit.net/usl6jas.css" />

    <!-- Google Fonts: Playfair Display + DM Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,300;1,9..40,400&family=Playfair+Display:wght@600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Roofle slide-out widget (sitewide) -->
    <script src="https://app.roofle.com/roof-quote-pro-widget.js?id=eto2wRKl4YZNBCbvWaSlL" async></script>
  </head>

  <body class="bg-hr-cream text-hr-text-primary font-sans antialiased">

    <Nav currentPath={currentPath} client:load />

    <main>
      <slot />
    </main>

    <Footer />

  </body>
</html>

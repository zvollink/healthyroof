---
// src/components/Hero.astro
---

<section class="relative min-h-[90vh] flex items-center overflow-hidden bg-hr-cream">

  <!-- Right side image panel -->
  <div class="absolute inset-y-0 right-0 w-full lg:w-[52%] z-0">
    <img
      src="https://images.squarespace-cdn.com/content/v1/67a26190d73f0f1126aa1024/97c792b9-6d62-4b78-9f6d-b1f9be51ca70/OC_TDSDP_StormCloud_intro_beautyshot_tif+%281%29.jpg"
      alt="Quality roof shingles close up"
      class="w-full h-full object-cover object-center"
    />
    <!-- Gradient fade from left (desktop) -->
    <div class="absolute inset-y-0 left-0 w-2/3 bg-gradient-to-r from-hr-cream via-hr-cream/85 to-transparent xl:via-hr-cream/75 lg:via-hr-cream/75"></div>
    <!-- Mobile: strong top overlay so text is readable -->
    <div class="absolute inset-0 bg-gradient-to-b from-hr-cream/95 via-hr-cream/80 to-hr-cream/20 lg:hidden"></div>
    <!-- Subtle overlay -->
    <div class="absolute inset-0 bg-hr-text-primary/10"></div>
  </div>

  <!-- Left side content -->
  <div class="relative z-10 max-w-7xl mx-auto px-6 sm:px-10 lg:px-8 w-full py-24 lg:py-32">
    <div class="max-w-md">

      <!-- Eyebrow -->
      <div class="flex items-center gap-3 mb-6 fade-up" style="animation-delay: 0ms;">
        <span class="text-xs font-semibold uppercase tracking-widest text-hr-text-primary bg-hr-yellow px-3 py-1 rounded-full">
          West Michigan Roof Specialists
        </span>
      </div>

      <!-- Headline -->
      <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-bold text-hr-text-primary leading-[1.05] tracking-tight mb-5 fade-up" style="animation-delay: 80ms;">
        Here, roofs<br />
        <span class="text-hr-teal">last longer.</span>
      </h1>

      <!-- Subheadline -->
      <p class="text-base sm:text-lg text-hr-text-secondary leading-relaxed mb-8 fade-up" style="animation-delay: 160ms;">
        Know where your roof stands today so you can plan confidently for tomorrow.
      </p>

      <!-- CTA group -->
      <div class="flex flex-col items-start gap-3 fade-up" style="animation-delay: 240ms;">
        <a
          href="/schedule"
          class="inline-flex items-center gap-2 bg-hr-teal hover:bg-hr-teal-dark text-white font-semibold text-sm px-6 py-3.5 rounded-full transition-all duration-200 shadow-md hover:shadow-lg group whitespace-normal sm:whitespace-nowrap"
        >
          Schedule a Roof Health Assessment
          <svg
            class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5"
            fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>

        <a
          href="tel:6162841925"
          class="inline-flex items-center gap-2 text-hr-text-secondary hover:text-hr-teal font-medium text-sm transition-colors duration-200"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          Call or Text: 616-284-1925
        </a>
      </div>

      <!-- Trust signals -->
      <div class="mt-10 pt-8 border-t border-hr-stone flex flex-wrap gap-x-5 gap-y-2 fade-up" style="animation-delay: 320ms;">
        {[
          "Locally Owned",
          "Certified Inspectors",
          "Drone & Thermal Imaging",
          "No Pressure",
        ].map((item) => (
          <span class="flex items-center gap-1.5 text-xs font-medium text-hr-text-secondary">
            <span class="w-1.5 h-1.5 rounded-full bg-hr-yellow shrink-0"></span>
            {item}
          </span>
        ))}
      </div>

    </div>
  </div>

</section>

<style>
  .fade-up {
    opacity: 0;
    transform: translateY(16px);
    animation: fadeUp 0.55s ease forwards;
  }

  @keyframes fadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
---
// Footer.astro
---

<footer class="bg-hr-teal-dark text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-20">

    <!-- 4-column grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">

      <!-- Col 1: Brand -->
      <div class="lg:col-span-1">
        <div class="flex items-center gap-3 mb-4">
          <img src="/images/hr-logo-yellow.png" alt="Healthy Roof" class="h-10 w-auto" />
          <div class="flex flex-col leading-none">
            <span class="font-futura text-lg font-bold text-white tracking-tight">Healthy Roof</span>
            <span class="text-[10px] font-medium text-hr-yellow tracking-widest uppercase">Here, roofs last longer</span>
          </div>
        </div>
        <p class="text-sm text-white/70 leading-relaxed">
          Thoughtful roof care, clear guidance, and long-term solutions for homeowners across West Michigan.
        </p>
      </div>

      <!-- Col 2: Contact -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-widest text-hr-yellow mb-5">Contact</h3>
        <ul class="flex flex-col gap-3 text-sm text-white/80">
          <li>
            <a href="tel:6162851025" class="flex items-center gap-2 hover:text-hr-yellow transition-colors">
              <svg class="w-4 h-4 shrink-0 text-hr-yellow/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
              616.285.1025
            </a>
          </li>
          <li>
            <a href="mailto:info@thehealthyroof.com" class="flex items-center gap-2 hover:text-hr-yellow transition-colors">
              <svg class="w-4 h-4 shrink-0 text-hr-yellow/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
              info@thehealthyroof.com
            </a>
          </li>
          <li class="flex items-start gap-2 text-white/60">
            <svg class="w-4 h-4 shrink-0 mt-0.5 text-hr-yellow/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <span>Greater Grand Rapids &amp; West Michigan</span>
          </li>
        </ul>
      </div>

      <!-- Col 3: Services -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-widest text-hr-yellow mb-5">Services</h3>
        <ul class="flex flex-col gap-2.5 text-sm text-white/80">
          {[
            ["Roof Health Assessment", "/roof-health-assessment"],
            ["Roof Rejuvenation", "/services/roof-rejuvenation"],
            ["Roof Repairs", "/services/roof-repairs"],
            ["Roof Replacement", "/services/roof-replacement"],
            ["Maintenance Planning", "/services/maintenance-planning"],
          ].map(([label, href]) => (
            <li>
              <a href={href} class="hover:text-hr-yellow transition-colors">{label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Credentials -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-widest text-hr-yellow mb-5">Why Healthy Roof</h3>
        <ul class="flex flex-col gap-2.5 text-sm text-white/80">
          {[
            "Locally Owned & Operated",
            "Fully Insured",
            "Certified Home Inspectors",
            "Drone & Thermal Inspections",
            "ICCRC Certified Mold Inspector",
            "Licensed Builders",
            "BBB Certified",
          ].map((item) => (
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-hr-yellow shrink-0"></span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Divider -->
    <div class="mt-12 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-white/40 text-center sm:text-left">
        © {new Date().getFullYear()} Healthy Roof. All rights reserved. Serving the communities we live and work in.
      </p>
      <div class="flex items-center gap-6 text-xs text-white/40">
        <a href="/privacy" class="hover:text-white/70 transition-colors">Privacy Policy</a>
        <a href="/sitemap" class="hover:text-white/70 transition-colors">Sitemap</a>
      </div>
    </div>

  </div>
</footer>

---
// src/components/SocialProof.astro

const reviews = [
  {
    name: "Sarah M.",
    location: "Ada, MI",
    stars: 5,
    text: "Chris walked me through every finding on my roof like a teacher, not a salesperson. I finally understood what I was looking at. No pressure, just clear answers. Highly recommend.",
  },
  {
    name: "Tom & Linda K.",
    location: "Cascade, MI",
    stars: 5,
    text: "We've had other roofers out before and always felt rushed. HealthyRoof took their time, used drone imaging, and gave us a full picture. We felt genuinely informed.",
  },
  {
    name: "David R.",
    location: "Rockford, MI",
    stars: 5,
    text: "I'm an engineer and I appreciate data. The thermal imaging report was detailed and they explained exactly what it meant. Best roofing experience I've ever had.",
  },
  {
    name: "Jennifer P.",
    location: "Grandville, MI",
    stars: 5,
    text: "They told me my roof had a few more years in it and explained what to watch for. A lesser company would have sold me a replacement I didn't need. That kind of honesty earns my trust.",
  },
  {
    name: "Mark &amp; Amy S.",
    location: "Lowell, MI",
    stars: 5,
    text: "The rejuvenation treatment bought us more time before replacement — at a fraction of the cost. Wish we'd found HealthyRoof years ago.",
  },
  {
    name: "Carol B.",
    location: "Caledonia, MI",
    stars: 5,
    text: "As a retiree on a fixed income, I needed someone I could trust to give me honest options. HealthyRoof was exactly that. Professional, thorough, and genuinely kind.",
  },
];

const credentials = [
  { label: "Locally Owned & Operated", icon: "home" },
  { label: "Fully Insured", icon: "shield" },
  { label: "Certified Home Inspectors", icon: "badge" },
  { label: "Drone & Thermal Inspections", icon: "drone" },
  { label: "ICCRC Certified Mold Inspector", icon: "leaf" },
  { label: "Licensed Builders", icon: "hammer" },
  { label: "BBB Certified", icon: "star" },
];
---

<section class="bg-hr-stone py-24 lg:py-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-14 reveal-up">
      <div class="flex items-center justify-center gap-3 mb-5">
        <span class="text-xs font-semibold uppercase tracking-widest text-hr-text-primary bg-hr-yellow px-3 py-1 rounded-full">Trusted Reviews</span>
      </div>
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-hr-text-primary leading-[1.1] tracking-tight mb-4">
        Trusted by homeowners<br class="hidden sm:block" />
        <span class="text-hr-teal">across West Michigan.</span>
      </h2>

      <!-- Star rating bar -->
      <div class="flex flex-col items-center gap-2 mt-6">
        <div class="flex items-center gap-1">
          {Array.from({ length: 5 }).map(() => (
            <svg class="w-6 h-6 text-hr-yellow" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>
        <p class="text-sm text-hr-text-secondary font-medium">5.0 — Based on verified homeowner reviews</p>
      </div>
    </div>

    <!-- Review cards grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-20 reveal-up" style="transition-delay: 0.1s;">
      {reviews.map((review) => (
        <div class="bg-white rounded-2xl p-6 shadow-sm flex flex-col gap-4 hover:shadow-md transition-shadow duration-200">
          <!-- Stars -->
          <div class="flex items-center gap-0.5">
            {Array.from({ length: review.stars }).map(() => (
              <svg class="w-4 h-4 text-hr-yellow" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <!-- Quote -->
          <p class="text-sm text-hr-text-secondary leading-relaxed flex-1">&ldquo;{review.text}&rdquo;</p>
          <!-- Reviewer -->
          <div class="flex items-center gap-3 pt-2 border-t border-hr-stone">
            <div class="w-8 h-8 rounded-full bg-hr-teal/10 flex items-center justify-center shrink-0">
              <span class="text-xs font-bold text-hr-teal">{review.name.charAt(0)}</span>
            </div>
            <div>
              <p class="text-sm font-semibold text-hr-text-primary" set:html={review.name} />
              <p class="text-xs text-hr-text-muted">{review.location}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Before / After photo strip -->
    <div class="mb-20 reveal-up" style="transition-delay: 0.15s;">
      <h3 class="font-display text-2xl font-bold text-hr-text-primary text-center mb-8">Real Homes. Real Results.</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div class="rounded-2xl overflow-hidden aspect-video relative shadow-sm group">
          <img
            src="/images/Before and Afters/BeforeAfter01.jpg"
            alt="Before and after roof replacement — West Michigan"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-hr-text-primary/40 to-transparent"></div>
          <span class="absolute bottom-4 left-4 text-white text-xs font-semibold uppercase tracking-wider bg-hr-teal px-3 py-1.5 rounded-full">West Michigan</span>
        </div>
        <div class="rounded-2xl overflow-hidden aspect-video relative shadow-sm group">
          <img
            src="/images/Before and Afters/BeforeAfter03.jpg"
            alt="Before and after roof replacement — West Michigan"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-hr-text-primary/40 to-transparent"></div>
          <span class="absolute bottom-4 left-4 text-white text-xs font-semibold uppercase tracking-wider bg-hr-teal px-3 py-1.5 rounded-full">Grand Rapids</span>
        </div>
      </div>
    </div>

    <!-- Credentials bar -->
    <div class="reveal-up" style="transition-delay: 0.2s;">
      <div class="bg-hr-teal rounded-2xl px-8 py-8 shadow-md">
        <p class="text-center text-xs font-semibold uppercase tracking-widest text-hr-yellow mb-7">Our Credentials</p>
        <div class="flex flex-wrap justify-center gap-x-8 gap-y-5">
          {credentials.map((c) => (
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-hr-yellow shrink-0"></span>
              <span class="text-sm font-medium text-white/85">{c.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-14 text-center reveal-up" style="transition-delay: 0.25s;">
      <a
        href="/schedule"
        class="inline-flex items-center gap-2 bg-hr-teal hover:bg-hr-teal-dark text-white font-semibold text-sm px-7 py-4 rounded-full transition-all duration-200 shadow-md hover:shadow-lg group"
      >
        Ready to understand your roof?
        <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

  </div>
</section>

<style>
  .reveal-up {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .reveal-up.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  document.querySelectorAll('.reveal-up').forEach((el) => {
    new IntersectionObserver(
      ([entry]) => { if (entry.isIntersecting) { el.classList.add('visible'); } },
      { threshold: 0.1 }
    ).observe(el);
  });
</script>

---
// src/components/WhyWeExist.astro
---

<section class="bg-hr-cream py-24 lg:py-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Two-column layout: copy left, visual right -->
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-24 items-center">

      <!-- Left: copy -->
      <div class="reveal-left">

        <!-- Section eyebrow -->
        <div class="flex items-center gap-3 mb-6">
          <span class="text-xs font-semibold uppercase tracking-widest text-hr-text-primary bg-hr-yellow px-3 py-1 rounded-full">
            Why Healthy Roof Exists
          </span>
        </div>

        <h2 class="font-display text-4xl sm:text-5xl font-bold text-hr-text-primary leading-[1.1] tracking-tight mb-6">
          Roofing decisions shouldn't<br class="hidden sm:block" />
          feel <span class="text-hr-teal">overwhelming.</span>
        </h2>

        <div class="space-y-5 text-hr-text-secondary leading-relaxed">
          <p class="text-base sm:text-lg">
            Healthy Roof was built to help homeowners understand their roofs, care for them properly,
            and make confident, well&#8209;timed decisions — without the pressure that too often
            comes with the territory.
          </p>
          <p class="text-base sm:text-lg">
            From routine maintenance and targeted repairs to rejuvenation treatments and full
            replacements when the time is right, we support the entire life of your roof — helping
            you plan ahead and feel good about your home.
          </p>
          <p class="text-base sm:text-lg">
            As a locally owned, independent company in West Michigan, we're committed to giving
            homeowners a clearer, more honest path forward — one rooftop at a time.
          </p>
        </div>

        <!-- Divider + values pills -->
        <div class="mt-10 pt-8 border-t border-hr-stone">
          <div class="flex flex-wrap gap-3">
            {[
              "Roof longevity",
              "Honest guidance",
              "West Michigan roots",
              "Your whole roof's life",
            ].map((v) => (
              <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-white bg-hr-teal px-4 py-2 rounded-full">
                <span class="w-1.5 h-1.5 rounded-full bg-hr-yellow shrink-0"></span>
                {v}
              </span>
            ))}
          </div>
        </div>

      </div>

      <!-- Right: visual card stack -->
      <div class="relative reveal-right">

        <!-- Main photo card -->
        <div class="relative rounded-2xl overflow-hidden shadow-xl aspect-[4/5] max-w-sm mx-auto lg:max-w-none">
          <img
            src="/images/Roof Replacement Drone Neighborhood shots (Thornquist 2025)/dji_fly_20250919_105810_0082_1758329182377_photo.JPG"
            alt="West Michigan neighborhood aerial — homes we serve"
            class="w-full h-full object-cover object-center"
          />
          <!-- Subtle teal tint overlay -->
          <div class="absolute inset-0 bg-hr-teal/10"></div>
        </div>

        <!-- Floating stat card — bottom-left -->
        <div class="absolute -bottom-6 -left-4 lg:-left-10 bg-white rounded-xl shadow-lg px-5 py-4 max-w-[200px] stat-card">
          <p class="text-2xl font-display font-bold text-hr-text-primary leading-none mb-1">20+ yrs</p>
          <p class="text-xs font-medium text-hr-text-muted leading-snug">Combined roofing &amp; inspection experience</p>
        </div>

        <!-- Floating accent card — top-right -->
        <div class="absolute -top-5 -right-4 lg:-right-8 bg-hr-yellow rounded-xl shadow-lg px-5 py-4 max-w-[190px] stat-card">
          <p class="text-2xl font-display font-bold leading-none mb-1 text-hr-text-primary">Here for<br/>your roof.</p>
          <p class="text-xs font-medium text-hr-text-primary/60 leading-snug">From first inspection to final shingle</p>
        </div>

        <!-- Decorative dot grid (purely aesthetic) -->
        <div class="absolute -z-10 -bottom-8 -right-8 w-40 h-40 dot-grid opacity-30" aria-hidden="true"></div>

      </div>

    </div>
  </div>
</section>

<style>
  /* ── Scroll-reveal animations ── */
  .reveal-left,
  .reveal-right {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.65s ease, transform 0.65s ease;
  }

  .reveal-right {
    transition-delay: 0.1s;
  }

  .reveal-left.visible,
  .reveal-right.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Floating stat cards subtle entrance */
  .stat-card {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.5s ease 0.45s, transform 0.5s ease 0.45s;
  }

  .reveal-right.visible .stat-card {
    opacity: 1;
    transform: translateY(0);
  }

  /* Dot grid background pattern */
  .dot-grid {
    background-image: radial-gradient(circle, #148888 1px, transparent 1px);
    background-size: 18px 18px;
  }
</style>

<script>
  // Intersection Observer for scroll-reveal
  const targets = document.querySelectorAll('.reveal-left, .reveal-right');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );

  targets.forEach((el) => observer.observe(el));
</script>

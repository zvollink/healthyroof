---
// src/components/ScheduleCTA.astro

const steps = [
  {
    number: "01",
    title: "Reach Out",
    description: "Call or text to schedule your Roof Health Assessment at a time that works for you.",
  },
  {
    number: "02",
    title: "Thoughtful Assessment",
    description: "We evaluate your roof's condition and walk you through what we find — clear visuals, plain language, no jargon.",
  },
  {
    number: "03",
    title: "Options & Planning",
    description: "You receive honest guidance and realistic options so you can make a confident, well-timed decision.",
  },
];
---

<section class="py-20 lg:py-24 overflow-hidden relative">

  <!-- Background image -->
  <div class="absolute inset-0" aria-hidden="true">
    <img src="/images/background.jpg" alt="" class="w-full h-full object-cover object-center" />
    <!-- Dark teal overlay so text stays crisp and it reads as distinct from the footer -->
    <div class="absolute inset-0 bg-hr-teal-dark/90"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Two-column layout: CTA left, steps right -->
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center reveal-up">

      <!-- Left: headline + CTA -->
      <div>
        <div class="flex items-center gap-3 mb-5">
          <span class="h-px w-8 bg-hr-yellow/50 inline-block"></span>
          <span class="text-xs font-semibold uppercase tracking-widest text-hr-yellow">Get Started</span>
        </div>
        <h2 class="font-display text-4xl sm:text-5xl font-bold text-white leading-[1.1] tracking-tight mb-4">
          Schedule your Roof<br />Health Assessment.
        </h2>
        <p class="text-base text-white/65 leading-relaxed mb-8">
          Start with clear insight, practical guidance, and absolutely no pressure.
        </p>
        <div class="flex flex-col sm:flex-row items-start gap-3">
          <a
            href="/schedule"
            class="inline-flex items-center gap-2 bg-hr-yellow hover:bg-hr-yellow-dark text-hr-text-primary font-bold text-sm px-7 py-3.5 rounded-full transition-all duration-200 shadow-lg hover:shadow-xl group whitespace-nowrap"
          >
            Schedule Online
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          <a
            href="tel:6162851025"
            class="inline-flex items-center gap-2 border border-white/30 hover:border-hr-yellow text-white hover:text-hr-yellow font-semibold text-sm px-7 py-3.5 rounded-full transition-all duration-200 whitespace-nowrap"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            616.285.1025
          </a>
        </div>
        <p class="mt-4 text-xs text-white/40">No pressure. No obligation. Just clear answers.</p>
      </div>

      <!-- Right: 3 steps -->
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-white/40 mb-6">How it works</p>
        <div class="flex flex-col">
          {steps.map((step, i) => (
            <div class="flex gap-5 items-start group">
              <!-- Number + connector line -->
              <div class="flex flex-col items-center shrink-0">
                <div class="w-10 h-10 rounded-full border-2 border-hr-yellow/40 flex items-center justify-center group-hover:border-hr-yellow group-hover:bg-hr-yellow/10 transition-all duration-300">
                  <span class="font-display font-bold text-hr-yellow text-xs">{step.number}</span>
                </div>
                {i < steps.length - 1 && (
                  <div class="w-px bg-white/10 my-1" style="height: 28px;"></div>
                )}
              </div>
              <!-- Text -->
              <div class="pb-7">
                <h3 class="font-display text-lg font-bold text-white mb-1">{step.title}</h3>
                <p class="text-sm text-white/60 leading-relaxed">{step.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .reveal-up {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .reveal-up.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  document.querySelectorAll('.reveal-up').forEach((el) => {
    new IntersectionObserver(
      ([entry]) => { if (entry.isIntersecting) { el.classList.add('visible'); } },
      { threshold: 0.1 }
    ).observe(el);
  });
</script>

---
import Layout from '../../layouts/Layout.astro';

const benefits = [
  "Helps shingles remain flexible and resist cracking",
  "Slows the natural drying and aging process",
  "Improves overall roof performance",
  "Extends usable roof life when applied at the right time",
  "Fraction of the cost of full replacement",
];

const whenItWorks = [
  "Roof is aging but still structurally sound",
  "Granule loss is beginning",
  "Minor curling or dryness present",
  "You're in the budget planning stage",
  "You want to delay replacement 3–7 years",
];

const whenReplacement = [
  "Structural damage is present",
  "Active or recurring leaks",
  "Multiple shingle layers already installed",
  "Severe storm damage",
  "Roof is truly at end of life",
];

const process = [
  { step: "01", title: "Assessment", desc: "We evaluate the full roof condition first to determine if treatment is the right option for your home." },
  { step: "02", title: "Cleaning", desc: "The roof surface is prepared and cleaned to ensure proper product adhesion and performance." },
  { step: "03", title: "Application", desc: "The soy-based treatment is applied in a controlled, consistent manner across the entire roof surface." },
  { step: "04", title: "Monitoring", desc: "We follow up to ensure the treatment is performing as expected and answer any questions." },
];
---

<Layout
  title="Roof Rejuvenation — HealthyRoof"
  description="Extend the life of your roof with our rejuvenation treatment. Restore flexibility, improve performance, and delay costly replacement — when the timing is right."
>

  <!-- ── Hero ── -->
  <section class="relative min-h-[60vh] flex items-center overflow-hidden bg-hr-cream">
    <div class="absolute inset-y-0 right-0 w-full lg:w-[52%] z-0">
      <img
        src="/images/Roof Wash (Benjamin 2025)/46-Aug 04 2025 07_27pm-kYL9.jpg"
        alt="HealthyRoof technician applying roof rejuvenation treatment"
        class="w-full h-full object-cover object-center"
      />
      <div class="absolute inset-y-0 left-0 w-2/3 bg-gradient-to-r from-hr-cream via-hr-cream/85 to-transparent"></div>
      <div class="absolute inset-0 bg-hr-text-primary/10"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 sm:px-10 lg:px-8 w-full py-16 lg:py-20">
      <div class="max-w-md">
        <div class="flex items-center gap-3 mb-5 fade-up" style="animation-delay: 0ms;">
          <span class="h-px w-8 bg-hr-teal inline-block"></span>
          <span class="text-xs font-semibold uppercase tracking-widest text-hr-teal">Roof Rejuvenation</span>
        </div>
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-hr-text-primary leading-[1.05] tracking-tight mb-4 fade-up" style="animation-delay: 80ms;">
          Extend the life<br />
          <span class="text-hr-teal">of your roof.</span>
        </h1>
        <p class="text-base text-hr-text-secondary leading-relaxed mb-7 fade-up" style="animation-delay: 160ms;">
          Restore flexibility, improve performance, and delay costly replacement with a thoughtful rejuvenation approach — when your roof still has years left in it.
        </p>
        <div class="flex flex-col sm:flex-row items-start gap-3 fade-up" style="animation-delay: 240ms;">
          <a href="/schedule" class="inline-flex items-center gap-2 bg-hr-teal hover:bg-hr-teal-dark text-white font-semibold text-sm px-6 py-3.5 rounded-full transition-all duration-200 shadow-md hover:shadow-lg group whitespace-nowrap">
            Schedule a Roof Health Assessment
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
          <a href="tel:6162851025" class="inline-flex items-center gap-2 text-hr-text-secondary hover:text-hr-teal font-medium text-sm transition-colors duration-200">
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
            Call or Text: 616.285.1025
          </a>
        </div>
        <p class="mt-3 text-xs text-hr-text-muted fade-up" style="animation-delay: 300ms;">No pressure. No obligation. Just clear answers.</p>
      </div>
    </div>
  </section>

  <!-- ── What Rejuvenation Does ── -->
  <section class="bg-hr-stone py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-14 lg:gap-24 items-center">
        <div class="reveal-up">
          <div class="flex items-center gap-3 mb-5">
            <span class="h-px w-8 bg-hr-teal inline-block shrink-0"></span>
            <span class="text-xs font-semibold uppercase tracking-widest text-hr-teal">What Rejuvenation Does</span>
          </div>
          <h2 class="font-display text-4xl sm:text-5xl font-bold text-hr-text-primary leading-[1.1] tracking-tight mb-6">
            A smarter way to<br />
            <span class="text-hr-teal">slow the aging process.</span>
          </h2>
          <div class="space-y-4 text-hr-text-secondary leading-relaxed text-base mb-8">
            <p>Over time, asphalt shingles naturally dry out and lose flexibility. As they become more brittle, they're more prone to damage from weather and temperature changes.</p>
            <p>Our rejuvenation treatment uses a soy-based solution to restore the flexibility, hydration, UV protection, and durability of your shingles — extending the life of your roof when it still has good structure.</p>
          </div>
          <ul class="flex flex-col gap-3">
            {benefits.map((item) => (
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-hr-teal/10 flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3 h-3 text-hr-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                </span>
                <span class="text-sm font-medium text-hr-text-secondary">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="relative reveal-up" style="transition-delay: 0.1s;">
          <div class="rounded-2xl overflow-hidden shadow-xl aspect-[4/3]">
            <img
              src="/images/Roof Wash (Benjamin 2025)/40-Aug 04 2025 04_03pm-g7xk.jpg"
              alt="Roof rejuvenation treatment application"
              class="w-full h-full object-cover object-center"
            />
          </div>
          <div class="absolute -bottom-5 -left-4 lg:-left-8 bg-white rounded-xl shadow-lg px-5 py-4 max-w-[200px]">
            <p class="text-2xl font-display font-bold text-hr-text-primary leading-none mb-1">Soy-based</p>
            <p class="text-xs font-medium text-hr-text-muted leading-snug">Eco-friendly treatment that restores shingle flexibility</p>
          </div>
          <div class="absolute -z-10 -bottom-6 -right-6 w-36 h-36 dot-grid opacity-25" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── When It Makes Sense / When It Doesn't ── -->
  <section class="bg-hr-cream py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-14 reveal-up">
        <div class="flex items-center justify-center gap-3 mb-5">
          <span class="h-px w-8 bg-hr-teal inline-block"></span>
          <span class="text-xs font-semibold uppercase tracking-widest text-hr-teal">Honest Guidance</span>
          <span class="h-px w-8 bg-hr-teal inline-block"></span>
        </div>
        <h2 class="font-display text-4xl sm:text-5xl font-bold text-hr-text-primary leading-[1.1] tracking-tight mb-4">
          Is rejuvenation right<br />
          <span class="text-hr-teal">for your roof?</span>
        </h2>
        <p class="text-base sm:text-lg text-hr-text-secondary leading-relaxed">
          We'll always tell you honestly. If replacement is the better path, we'll say so — and help you plan for it.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 gap-6 reveal-up" style="transition-delay: 0.1s;">
        <div class="bg-white rounded-2xl p-10 shadow-sm">
          <div class="flex items-center gap-3 mb-6">
            <span class="w-8 h-8 rounded-full bg-hr-teal/10 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-hr-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
            </span>
            <h3 class="font-display text-xl font-bold text-hr-text-primary">When it makes sense</h3>
          </div>
          <ul class="flex flex-col gap-3">
            {whenItWorks.map((item) => (
              <li class="flex items-start gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-hr-teal shrink-0 mt-2"></span>
                <span class="text-sm text-hr-text-secondary leading-snug">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-hr-stone rounded-2xl p-10 shadow-sm">
          <div class="flex items-center gap-3 mb-6">
            <span class="w-8 h-8 rounded-full bg-hr-text-muted/10 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-hr-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            </span>
            <h3 class="font-display text-xl font-bold text-hr-text-primary">When replacement is better</h3>
          </div>
          <ul class="flex flex-col gap-3">
            {whenReplacement.map((item) => (
              <li class="flex items-start gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-hr-text-muted shrink-0 mt-2"></span>
                <span class="text-sm text-hr-text-secondary leading-snug">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Our Process ── -->
  <section class="bg-hr-stone py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-14 reveal-up">
        <div class="flex items-center justify-center gap-3 mb-5">
          <span class="h-px w-8 bg-hr-teal inline-block"></span>
          <span class="text-xs font-semibold uppercase tracking-widest text-hr-teal">Our Process</span>
          <span class="h-px w-8 bg-hr-teal inline-block"></span>
        </div>
        <h2 class="font-display text-4xl sm:text-5xl font-bold text-hr-text-primary leading-[1.1] tracking-tight">
          How we approach<br />
          <span class="text-hr-teal">every treatment.</span>
        </h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 reveal-up" style="transition-delay: 0.1s;">
        {process.map((p) => (
          <div class="bg-white rounded-2xl p-6 shadow-sm">
            <p class="font-display text-3xl font-bold text-hr-teal/20 mb-4">{p.step}</p>
            <h3 class="font-display text-lg font-bold text-hr-text-primary mb-2">{p.title}</h3>
            <p class="text-sm text-hr-text-secondary leading-relaxed">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Final CTA ── -->
  <section class="py-20 lg:py-24 overflow-hidden relative">
    <div class="absolute inset-0" aria-hidden="true">
      <img src="/images/Roof Replacement Drone Neighborhood shots (Thornquist 2025)/dji_fly_20250919_105910_0085_1758329181586_photo.JPG" alt="" class="w-full h-full object-cover object-center" />
      <div class="absolute inset-0 bg-hr-teal-dark/90"></div>
    </div>
    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal-up">
      <div class="flex items-center justify-center gap-3 mb-5">
        <span class="h-px w-8 bg-hr-yellow/50 inline-block"></span>
        <span class="text-xs font-semibold uppercase tracking-widest text-hr-yellow">Find Out If Your Roof Qualifies</span>
        <span class="h-px w-8 bg-hr-yellow/50 inline-block"></span>
      </div>
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-white leading-[1.1] tracking-tight mb-4">
        Every roof is different.
      </h2>
      <p class="text-base text-white/65 leading-relaxed mb-8 max-w-xl mx-auto">
        A Roof Health Assessment helps determine whether rejuvenation is the right option for your home — no guesswork, no pressure.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/schedule" class="inline-flex items-center gap-2 bg-hr-yellow hover:bg-hr-yellow-dark text-hr-text-primary font-bold text-sm px-7 py-3.5 rounded-full transition-all duration-200 shadow-lg group whitespace-nowrap">
          Schedule Roof Health Assessment
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
        </a>
        <a href="tel:6162851025" class="inline-flex items-center gap-2 border border-white/30 hover:border-hr-yellow text-white hover:text-hr-yellow font-semibold text-sm px-7 py-3.5 rounded-full transition-all duration-200 whitespace-nowrap">
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
          616.285.1025
        </a>
      </div>
      <p class="mt-5 text-xs text-white/40">No pressure. Just clear guidance.</p>
    </div>
  </section>

</Layout>

<style>
  .fade-up { opacity: 0; transform: translateY(16px); animation: fadeUp 0.55s ease forwards; }
  @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }
  .reveal-up { opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .reveal-up.visible { opacity: 1; transform: translateY(0); }
  .dot-grid { background-image: radial-gradient(circle, #1A8A84 1px, transparent 1px); background-size: 18px 18px; }
</style>

<script>
  document.querySelectorAll('.reveal-up').forEach((el) => {
    new IntersectionObserver(([entry]) => { if (entry.isIntersecting) el.classList.add('visible'); }, { threshold: 0.12 }).observe(el);
  });
</script>

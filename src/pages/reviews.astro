---
import Layout from '../layouts/Layout.astro';

// ─── Replace placeholders with real reviews as they come in ───────────────────
const reviews = [
  {
    name: "Sarah M.",
    location: "Ada, MI",
    rating: 5,
    date: "March 2025",
    text: "Chris walked me through everything he found — I finally understood what was actually going on with my roof after years of guessing. No pressure, just straight answers. Exactly what I needed.",
  },
  {
    name: "Dave & Karen T.",
    location: "Cascade, MI",
    rating: 5,
    date: "February 2025",
    text: "We called Healthy Roof after getting a quote from another company that felt way too aggressive. These guys told us we had a few more years left and helped us plan accordingly. Refreshingly honest.",
  },
  {
    name: "Linda R.",
    location: "Rockford, MI",
    rating: 5,
    date: "January 2025",
    text: "The photo report they sent was incredibly clear. I could actually see what they were seeing and understand why they were recommending what they did. Best roofing experience I've had.",
  },
  {
    name: "Mike J.",
    location: "Grand Rapids, MI",
    rating: 5,
    date: "April 2025",
    text: "I'm an engineer and I appreciate that they explained the whole system — not just the shingles. The attic ventilation issue they found would have caused real problems down the road.",
  },
  {
    name: "Patricia W.",
    location: "Kentwood, MI",
    rating: 5,
    date: "March 2025",
    text: "I've been putting off dealing with my roof for two years because I didn't trust that I'd get honest advice. Healthy Roof changed that. They told me what could wait and what couldn't — and I believed them.",
  },
  {
    name: "Tom & Julie B.",
    location: "Grandville, MI",
    rating: 5,
    date: "May 2025",
    text: "The rejuvenation treatment they recommended saved us from a full replacement we weren't ready for. Roof looks and performs great. Will absolutely call them again.",
  },
];

const beforeAfters = [
  {
    before: "/images/Before and Afters/sutton2025_01before1.jpg",
    after: "/images/Before and Afters/sutton2025_01after.jpg",
    label: "Sutton Residence — Grand Rapids",
    service: "Roof Replacement",
  },
  {
    before: "/images/Before and Afters/Benjamin 2025_02 before.jpg",
    after: "/images/Before and Afters/Benjamin 2025_02 after.jpg",
    label: "Benjamin Residence — West Michigan",
    service: "Roof Wash & Rejuvenation",
  },
  {
    before: "/images/Before and Afters/sutton2025_03before.jpg",
    after: "/images/Before and Afters/sutton2025_03after.jpg",
    label: "Sutton Residence — Detail",
    service: "Roof Replacement",
  },
];

const credentials = [
  "Locally Owned & Operated",
  "Fully Insured",
  "Certified Home Inspectors",
  "Drone Certified",
  "IICRC Mold Specialist",
  "Licensed Builders",
  "BBB Certified",
];
---

<Layout
  title="Reviews — Healthy Roof | Grand Rapids, MI"
  description="See what West Michigan homeowners say about Healthy Roof. Honest assessments, clear guidance, and long-term roof care — no pressure, no upselling."
>

  <!-- ── Hero ── -->
  <section class="relative min-h-[52vh] flex items-center overflow-hidden bg-hr-cream">
    <div class="absolute inset-0 z-0">
      <img
        src="/images/Roof Replacement Drone Neighborhood shots (Thornquist 2025)/dji_fly_20250919_105622_0076_1758329184374_photo.JPG"
        alt="West Michigan neighborhood — Healthy Roof service area"
        class="w-full h-full object-cover object-center"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-hr-cream via-hr-cream/80 to-hr-cream/20"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-hr-cream/95 via-hr-cream/80 to-hr-cream/20 lg:hidden"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 sm:px-10 lg:px-8 w-full py-20 lg:py-28">
      <div class="max-w-lg">

        <div class="flex items-center gap-3 mb-5 fade-up" style="animation-delay: 0ms;">
          <span class="h-px w-8 bg-hr-teal inline-block"></span>
          <span class="text-xs font-semibold uppercase tracking-widest text-hr-teal">Reviews</span>
        </div>

        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-hr-text-primary leading-[1.05] tracking-tight mb-5 fade-up" style="animation-delay: 80ms;">
          Trusted by homeowners<br />
          <span class="text-hr-teal">across West Michigan.</span>
        </h1>

        <p class="text-base sm:text-lg text-hr-text-secondary leading-relaxed mb-8 fade-up" style="animation-delay: 160ms;">
          We believe trust is built one honest conversation at a time. Here's what our neighbors have to say.
        </p>

        <!-- Star summary -->
        <div class="inline-flex items-center gap-3 bg-white rounded-2xl px-5 py-3.5 shadow-sm border border-hr-teal/10 fade-up" style="animation-delay: 240ms;">
          <div class="flex items-center gap-0.5">
            {[1,2,3,4,5].map(() => (
              <svg class="w-5 h-5 text-hr-yellow" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <div>
            <p class="text-sm font-bold text-hr-text-primary leading-none">5.0</p>
            <p class="text-xs text-hr-text-muted mt-0.5">Based on verified homeowner reviews</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── Review Cards ── -->
  <section class="bg-hr-stone py-20 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center max-w-xl mx-auto mb-14 reveal-up">
        <div class="flex items-center justify-center gap-3 mb-5">
          <span class="h-px w-8 bg-hr-teal inline-block"></span>
          <span class="text-xs font-semibold uppercase tracking-widest text-hr-teal">What Homeowners Say</span>
          <span class="h-px w-8 bg-hr-teal inline-block"></span>
        </div>
        <h2 class="font-display text-4xl sm:text-5xl font-bold text-hr-text-primary leading-[1.1] tracking-tight">
          Building trust<br />
          <span class="text-hr-teal">one home at a time.</span>
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 reveal-up" style="transition-delay: 0.1s;">
        {reviews.map((review) => (
          <div class="bg-white rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow duration-200 flex flex-col">

            <!-- Stars -->
            <div class="flex items-center gap-0.5 mb-4">
              {Array.from({ length: review.rating }).map(() => (
                <svg class="w-4 h-4 text-hr-yellow" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>

            <!-- Quote -->
            <p class="text-sm text-hr-text-secondary leading-relaxed flex-1 mb-5">
              "{review.text}"
            </p>

            <!-- Reviewer -->
            <div class="flex items-center justify-between border-t border-hr-stone pt-4 mt-auto">
              <div>
                <p class="text-sm font-bold text-hr-text-primary">{review.name}</p>
                <p class="text-xs text-hr-text-muted">{review.location}</p>
              </div>
              <p class="text-xs text-hr-text-muted">{review.date}</p>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ── Before & After ── -->
  <section class="bg-hr-cream py-20 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center max-w-xl mx-auto mb-14 reveal-up">
        <div class="flex items-center justify-center gap-3 mb-5">
          <span class="h-px w-8 bg-hr-teal inline-block"></span>
          <span class="text-xs font-semibold uppercase tracking-widest text-hr-teal">Our Work</span>
          <span class="h-px w-8 bg-hr-teal inline-block"></span>
        </div>
        <h2 class="font-display text-4xl sm:text-5xl font-bold text-hr-text-primary leading-[1.1] tracking-tight mb-4">
          Before & after.
        </h2>
        <p class="text-base text-hr-text-secondary leading-relaxed">
          Real jobs, real results — for homeowners across West Michigan.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 reveal-up" style="transition-delay: 0.1s;">
        {beforeAfters.map((job) => (
          <div class="group">
            <div class="rounded-2xl overflow-hidden shadow-sm bg-hr-stone">

              <!-- Before -->
              <div class="relative">
                <div class="aspect-[4/3] overflow-hidden">
                  <img
                    src={job.before}
                    alt={`Before — ${job.label}`}
                    class="w-full h-full object-cover object-center group-hover:scale-[1.02] transition-transform duration-500"
                  />
                </div>
                <span class="absolute top-3 left-3 bg-hr-text-primary/70 text-white text-xs font-bold px-2.5 py-1 rounded-full uppercase tracking-widest">Before</span>
              </div>

              <!-- Divider -->
              <div class="flex items-center gap-2 px-4 py-2 bg-hr-stone">
                <span class="flex-1 h-px bg-hr-teal/20"></span>
                <svg class="w-4 h-4 text-hr-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
                <span class="flex-1 h-px bg-hr-teal/20"></span>
              </div>

              <!-- After -->
              <div class="relative">
                <div class="aspect-[4/3] overflow-hidden">
                  <img
                    src={job.after}
                    alt={`After — ${job.label}`}
                    class="w-full h-full object-cover object-center group-hover:scale-[1.02] transition-transform duration-500"
                  />
                </div>
                <span class="absolute top-3 left-3 bg-hr-teal text-white text-xs font-bold px-2.5 py-1 rounded-full uppercase tracking-widest">After</span>
              </div>

            </div>

            <!-- Caption -->
            <div class="mt-3 px-1">
              <p class="text-sm font-semibold text-hr-text-primary">{job.label}</p>
              <p class="text-xs text-hr-teal font-medium">{job.service}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ── Credentials ── -->
  <section class="bg-hr-stone py-14 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal-up">
      <p class="text-xs font-semibold uppercase tracking-widest text-hr-teal mb-6">Our Credentials</p>
      <div class="flex flex-wrap justify-center gap-3 mb-8">
        {credentials.map((cred) => (
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-hr-teal bg-white border border-hr-teal/20 px-3.5 py-1.5 rounded-full shadow-sm">
            <span class="w-1.5 h-1.5 rounded-full bg-hr-yellow shrink-0"></span>
            {cred}
          </span>
        ))}
      </div>
      <p class="text-sm text-hr-text-muted max-w-md mx-auto">
        Proud to care for homes in the communities we live and work in.
      </p>
    </div>
  </section>

  <!-- ── Final CTA ── -->
  <section class="py-20 lg:py-24 overflow-hidden relative">
    <div class="absolute inset-0" aria-hidden="true">
      <img
        src="/images/Roof Replacement Drone Neighborhood shots (Thornquist 2025)/dji_fly_20250919_105910_0085_1758329181586_photo.JPG"
        alt=""
        class="w-full h-full object-cover object-center"
      />
      <div class="absolute inset-0 bg-hr-teal-dark/90"></div>
    </div>

    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal-up">
      <div class="flex items-center justify-center gap-3 mb-5">
        <span class="h-px w-8 bg-hr-yellow/50 inline-block"></span>
        <span class="text-xs font-semibold uppercase tracking-widest text-hr-yellow">Ready to Get Started?</span>
        <span class="h-px w-8 bg-hr-yellow/50 inline-block"></span>
      </div>
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-white leading-[1.1] tracking-tight mb-4">
        Ready to understand<br />your roof?
      </h2>
      <p class="text-base text-white/65 leading-relaxed mb-8 max-w-xl mx-auto">
        Join the West Michigan homeowners who've traded roof anxiety for clear answers and a solid plan. Schedule your Roof Health Assessment today.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/schedule"
          class="inline-flex items-center gap-2 bg-hr-yellow hover:bg-hr-yellow-dark text-hr-text-primary font-bold text-sm px-7 py-3.5 rounded-full transition-all duration-200 shadow-lg hover:shadow-xl group whitespace-nowrap"
        >
          Schedule Roof Health Assessment
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        <a
          href="tel:6162841925"
          class="inline-flex items-center gap-2 border border-white/30 hover:border-hr-yellow text-white hover:text-hr-yellow font-semibold text-sm px-7 py-3.5 rounded-full transition-all duration-200 whitespace-nowrap"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          616-284-1925
        </a>
      </div>
      <p class="mt-5 text-xs text-white/40">No pressure. No obligation. Just clear answers.</p>
    </div>
  </section>

</Layout>

<style>
  .fade-up {
    opacity: 0;
    transform: translateY(16px);
    animation: fadeUp 0.55s ease forwards;
  }
  @keyframes fadeUp {
    to { opacity: 1; transform: translateY(0); }
  }

  .reveal-up {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .reveal-up.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  document.querySelectorAll('.reveal-up').forEach((el) => {
    new IntersectionObserver(
      ([entry]) => { if (entry.isIntersecting) { el.classList.add('visible'); } },
      { threshold: 0.12 }
    ).observe(el);
  });
</script>

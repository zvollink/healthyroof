---
import Layout from '../layouts/Layout.astro';

const credentials = [
  "Locally Owned & Operated",
  "Fully Insured",
  "Certified Home Inspectors",
  "Drone Certified",
  "IICRC Mold Specialist",
  "Licensed Builders",
  "BBB Certified",
];

const values = [
  {
    title: "Education first",
    desc: "We take time to help you understand your roof — because informed homeowners make better decisions.",
  },
  {
    title: "Honesty over sales",
    desc: "We'll tell you when something needs attention, and we'll tell you when it can wait. No upselling, ever.",
  },
  {
    title: "Whole-system thinking",
    desc: "Shingles are one piece. We evaluate ventilation, drainage, insulation, and structure — the full picture.",
  },
  {
    title: "Right timing matters",
    desc: "Acting too soon costs money. Waiting too long costs more. We help you find the right moment.",
  },
  {
    title: "Long-term relationship",
    desc: "We keep records of your roof's history so every future conversation has real context behind it.",
  },
  {
    title: "Local and independent",
    desc: "We're neighbors — not a PE-backed chain. We care about the homes in the communities we live in.",
  },
];
---

<Layout
  title="Who We Are — Healthy Roof | Grand Rapids, MI"
  description="Meet Chris Owen and Timothy Ridgell — the locally owned team behind Healthy Roof. Licensed builders, certified inspectors, and straight-talking guides for West Michigan homeowners."
>

  <!-- ── Hero ── -->
  <section class="relative min-h-[62vh] flex items-center overflow-hidden bg-hr-cream">

    <!-- Background image -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/Roof Replacement Drone Neighborhood shots (Thornquist 2025)/dji_fly_20250919_105304_0067_1758329187154_photo.JPG"
        alt="West Michigan neighborhood — Healthy Roof service area"
        class="w-full h-full object-cover object-center"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-hr-cream via-hr-cream/80 to-hr-cream/30"></div>
      <div class="absolute inset-0 bg-hr-text-primary/8"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-hr-cream/95 via-hr-cream/80 to-hr-cream/20 lg:hidden"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 sm:px-10 lg:px-8 w-full py-20 lg:py-28">
      <div class="max-w-lg">

        <div class="flex items-center gap-3 mb-5 fade-up" style="animation-delay: 0ms;">
          <span class="text-xs font-semibold uppercase tracking-widest text-hr-text-primary bg-hr-yellow px-3 py-1 rounded-full">Who We Are</span>
        </div>

        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-hr-text-primary leading-[1.05] tracking-tight mb-5 fade-up" style="animation-delay: 80ms;">
          A different kind<br />
          <span class="text-hr-teal">of roofing company.</span>
        </h1>

        <p class="text-base sm:text-lg text-hr-text-secondary leading-relaxed mb-8 fade-up" style="animation-delay: 160ms;">
          We were founded to give homeowners a clearer, more thoughtful path when it comes to roofing decisions — built on education, honest guidance, and long-term thinking.
        </p>

        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3 fade-up" style="animation-delay: 240ms;">
          <a
            href="/schedule"
            class="inline-flex items-center gap-2 bg-hr-teal hover:bg-hr-teal-dark text-white font-semibold text-sm px-6 py-3.5 rounded-full transition-all duration-200 shadow-md hover:shadow-lg group whitespace-normal sm:whitespace-nowrap"
          >
            Schedule a Roof Health Assessment
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <p class="mt-3 text-xs text-hr-text-secondary fade-up" style="animation-delay: 300ms;">
          No pressure. No obligation. Just clear answers.
        </p>

      </div>
    </div>
  </section>

  <!-- ── Meet the Owners ── -->
  <section class="bg-hr-stone py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center max-w-2xl mx-auto mb-16 reveal-up">
        <div class="flex items-center justify-center gap-3 mb-5">
          <span class="text-xs font-semibold uppercase tracking-widest text-hr-text-primary bg-hr-yellow px-3 py-1 rounded-full">The Team</span>
        </div>
        <h2 class="font-display text-4xl sm:text-5xl font-bold text-hr-text-primary leading-[1.1] tracking-tight mb-4">
          Neighbors you<br />
          <span class="text-hr-teal">can trust.</span>
        </h2>
        <p class="text-base sm:text-lg text-hr-text-secondary leading-relaxed">
          Healthy Roof is owned and operated by two local, licensed builders and certified inspectors who believe in doing things right - and being straight with the people they work for.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-10 lg:gap-16 reveal-up" style="transition-delay: 0.1s;">

        <!-- Chris -->
        <div class="bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300">
          <div class="aspect-[3/4] overflow-hidden">
            <img
              src="/images/Headshot Chris photo.jpg"
              alt="Chris Owen, co-owner of Healthy Roof"
              class="w-full h-full object-cover object-top"
            />
          </div>
          <div class="p-8">
            <h3 class="font-display text-2xl font-bold text-hr-text-primary mb-1">Chris Owen</h3>
            <p class="text-sm font-semibold text-hr-teal mb-4">Co-Owner & Certified Inspector</p>
            <p class="text-sm text-hr-text-secondary leading-relaxed mb-5">
              Chris brings years of hands-on experience in construction and roofing. As a licensed builder and certified home inspector, he approaches every assessment with the same goal: help the homeowner understand exactly what they're dealing with — clearly and honestly.
            </p>
            <div class="flex flex-wrap gap-2">
              {["Licensed Builder", "Certified Inspector", "IICRC Mold Specialist", "Drone Certified"].map((tag) => (
                <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-hr-teal bg-white border border-hr-teal/20 px-3 py-1 rounded-full">
                  <span class="w-1.5 h-1.5 rounded-full bg-hr-yellow shrink-0"></span>
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </div>

        <!-- Timothy -->
        <div class="bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300">
          <div class="aspect-[3/4] overflow-hidden">
            <img
              src="/images/Headshot Timothy photo.jpg"
              alt="Timothy Ridgell, co-owner of Healthy Roof"
              class="w-full h-full object-cover object-top"
            />
          </div>
          <div class="p-8">
            <h3 class="font-display text-2xl font-bold text-hr-text-primary mb-1">Timothy Ridgell</h3>
            <p class="text-sm font-semibold text-hr-teal mb-4">Co-Owner & Certified Inspector</p>
            <p class="text-sm text-hr-text-secondary leading-relaxed mb-5">
              Timothy is a licensed builder and certified inspector who brings a practical, systems-based perspective to every job. He's committed to giving homeowners the full picture — not just the easy answer — so they can make decisions they'll feel good about for years.
            </p>
            <div class="flex flex-wrap gap-2">
              {["Licensed Builder", "Certified Inspector", "Drone Certified"].map((tag) => (
                <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-hr-teal bg-white border border-hr-teal/20 px-3 py-1 rounded-full">
                  <span class="w-1.5 h-1.5 rounded-full bg-hr-yellow shrink-0"></span>
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── Credentials ── -->
  <section class="bg-hr-teal py-14 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal-up">
      <p class="text-xs font-semibold uppercase tracking-widest text-hr-yellow mb-6">Our Credentials</p>
      <div class="flex flex-wrap justify-center gap-3">
        {credentials.map((cred) => (
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-white bg-white/10 border border-white/20 px-3.5 py-1.5 rounded-full shadow-sm">
            <span class="w-1.5 h-1.5 rounded-full bg-hr-yellow shrink-0"></span>
            {cred}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Why Healthy Roof Exists ── -->
  <section class="bg-hr-cream py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-14 lg:gap-24 items-center">

        <!-- Content -->
        <div class="reveal-up">
          <div class="flex items-center gap-3 mb-5">
            <span class="text-xs font-semibold uppercase tracking-widest text-hr-text-primary bg-hr-yellow px-3 py-1 rounded-full">Why We Exist</span>
          </div>
          <h2 class="font-display text-4xl sm:text-5xl font-bold text-hr-text-primary leading-[1.1] tracking-tight mb-6">
            Roofing decisions shouldn't<br />
            <span class="text-hr-teal">feel overwhelming.</span>
          </h2>
          <div class="space-y-4 text-hr-text-secondary leading-relaxed text-base mb-6">
            <p>
              After years working in construction, restoration, and roofing environments, we saw how often homeowners were left unsure whether they truly needed major work — or simply needed better guidance.
            </p>
            <p>
              Healthy Roof was built to change that. We help homeowners understand their roofs, care for them properly, and make confident, well-timed decisions.
            </p>
            <p>
              From routine maintenance and targeted repairs to rejuvenation treatments and full replacements when needed, we support the entire life of your roof — helping you plan ahead and feel confident about your home.
            </p>
          </div>
          <div class="bg-white rounded-2xl px-5 py-4 border-l-4 border-hr-teal shadow-sm">
            <p class="text-sm font-medium text-hr-text-secondary leading-relaxed">
              As a locally owned, independent company, we're committed to helping homeowners care for and protect their homes for years to come. We're not a chain. We're neighbors.
            </p>
          </div>
        </div>

        <!-- Image -->
        <div class="relative reveal-up" style="transition-delay: 0.1s;">
          <div class="rounded-2xl overflow-hidden shadow-xl aspect-[4/3]">
            <img
              src="/images/Truck shots/24-Apr 15 2026 02_48pm-vYmV.jpg"
              alt="Healthy Roof truck — Grand Rapids, Michigan"
              class="w-full h-full object-cover object-center"
            />
          </div>
          <div class="absolute -z-10 -bottom-6 -right-6 w-36 h-36 dot-grid opacity-25" aria-hidden="true"></div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── Local Experience ── -->
  <section class="bg-hr-stone py-20 lg:py-24 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-14 lg:gap-24 items-center">

        <!-- Image -->
        <div class="relative reveal-up order-2 lg:order-1">
          <div class="rounded-2xl overflow-hidden shadow-xl aspect-[4/3]">
            <img
              src="/images/Roof Replacement Drone Neighborhood shots (Thornquist 2025)/dji_fly_20250919_105648_0077_1758329184101_photo.JPG"
              alt="Aerial view of Grand Rapids neighborhood — Healthy Roof service area"
              class="w-full h-full object-cover object-center"
            />
          </div>
          <div class="absolute -z-10 -bottom-6 -left-6 w-36 h-36 dot-grid opacity-25" aria-hidden="true"></div>
        </div>

        <!-- Content -->
        <div class="reveal-up order-1 lg:order-2" style="transition-delay: 0.1s;">
          <div class="flex items-center gap-3 mb-5">
            <span class="text-xs font-semibold uppercase tracking-widest text-hr-text-primary bg-hr-yellow px-3 py-1 rounded-full">Local Experience</span>
          </div>
          <h2 class="font-display text-4xl sm:text-5xl font-bold text-hr-text-primary leading-[1.1] tracking-tight mb-6">
            We know West Michigan<br />
            <span class="text-hr-teal">roofs.</span>
          </h2>
          <div class="space-y-4 text-hr-text-secondary leading-relaxed text-base mb-6">
            <p>
              Healthy Roof is locally owned and operated in the Greater Grand Rapids area. We understand the demands that West Michigan weather places on homes — the freeze-thaw cycles, ice dams, high winds, and heavy snow loads that wear roofs down over time.
            </p>
            <p>
              By focusing on careful evaluations and practical solutions, we help homeowners plan ahead rather than react to emergencies — avoiding unnecessary stress and costly surprises.
            </p>
          </div>

          <!-- Service area -->
          <div class="bg-white rounded-2xl px-5 py-4 border-l-4 border-hr-teal shadow-sm mb-6">
            <p class="text-xs font-semibold uppercase tracking-widest text-hr-teal mb-2">Service Area</p>
            <p class="text-sm text-hr-text-secondary leading-relaxed">
              Grand Rapids · Holland · Ada · Cascade · Grandville · Kentwood · Rockford · Walker · Caledonia · Lowell
            </p>
          </div>

          <a
            href="/schedule"
            class="inline-flex items-center gap-2 bg-hr-teal hover:bg-hr-teal-dark text-white font-semibold text-sm px-6 py-3.5 rounded-full transition-all duration-200 shadow-md hover:shadow-lg group whitespace-normal sm:whitespace-nowrap"
          >
            Schedule a Roof Health Assessment
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ── Our Values ── -->
  <section class="bg-hr-teal py-20 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center max-w-2xl mx-auto mb-14 reveal-up">
        <div class="flex items-center justify-center gap-3 mb-5">
          <span class="h-px w-8 bg-hr-yellow/50 inline-block"></span>
          <span class="text-xs font-semibold uppercase tracking-widest text-hr-yellow">What We Believe</span>
          <span class="h-px w-8 bg-hr-yellow/50 inline-block"></span>
        </div>
        <h2 class="font-display text-4xl sm:text-5xl font-bold text-white leading-[1.1] tracking-tight mb-4">
          How we show up<br />
          <span class="text-hr-yellow">for every homeowner.</span>
        </h2>
        <p class="text-base sm:text-lg text-white/70 leading-relaxed">
          These aren't talking points — they're the principles behind every conversation, every assessment, and every recommendation we make.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 reveal-up" style="transition-delay: 0.1s;">
        {values.map((v) => (
          <div class="bg-white/10 border border-white/15 rounded-2xl p-6 hover:bg-white/15 transition-colors duration-200">
            <span class="w-2 h-2 rounded-full bg-hr-yellow inline-block mb-4"></span>
            <h3 class="font-display text-lg font-bold text-white mb-2">{v.title}</h3>
            <p class="text-sm text-white/70 leading-relaxed">{v.desc}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ── Final CTA ── -->
  <section class="py-20 lg:py-24 overflow-hidden relative">
    <div class="absolute inset-0" aria-hidden="true">
      <img
        src="/images/Roof Replacement Drone Neighborhood shots (Thornquist 2025)/dji_fly_20250919_105724_0080_1758329183058_photo.JPG"
        alt=""
        class="w-full h-full object-cover object-center"
      />
      <div class="absolute inset-0 bg-hr-teal-dark/90"></div>
    </div>

    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal-up">
      <div class="flex items-center justify-center gap-3 mb-5">
        <span class="h-px w-8 bg-hr-yellow/50 inline-block"></span>
        <span class="text-xs font-semibold uppercase tracking-widest text-hr-yellow">Get Started</span>
        <span class="h-px w-8 bg-hr-yellow/50 inline-block"></span>
      </div>
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-white leading-[1.1] tracking-tight mb-4">
        Start with clear insight.
      </h2>
      <p class="text-base text-white/65 leading-relaxed mb-8 max-w-xl mx-auto">
        A Roof Health Assessment is the first step toward understanding your roof's condition and planning wisely for the future. Schedule a convenient time — we'll give you a clear picture and honest guidance on what comes next.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/schedule"
          class="inline-flex items-center gap-2 bg-hr-yellow hover:bg-hr-yellow-dark text-hr-text-primary font-bold text-sm px-7 py-3.5 rounded-full transition-all duration-200 shadow-lg hover:shadow-xl group whitespace-nowrap"
        >
          Schedule Roof Health Assessment
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        <a
          href="tel:6162851025"
          class="inline-flex items-center gap-2 border border-white/30 hover:border-hr-yellow text-white hover:text-hr-yellow font-semibold text-sm px-7 py-3.5 rounded-full transition-all duration-200 whitespace-nowrap"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          616.285.1025
        </a>
      </div>
      <p class="mt-5 text-xs text-white/40">No pressure. No obligation. Just clear answers.</p>
    </div>
  </section>

</Layout>

<style>
  .fade-up {
    opacity: 0;
    transform: translateY(16px);
    animation: fadeUp 0.55s ease forwards;
  }
  @keyframes fadeUp {
    to { opacity: 1; transform: translateY(0); }
  }

  .reveal-up {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .reveal-up.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .dot-grid {
    background-image: radial-gradient(circle, #148888 1px, transparent 1px);
    background-size: 18px 18px;
  }
</style>

<script>
  document.querySelectorAll('.reveal-up').forEach((el) => {
    new IntersectionObserver(
      ([entry]) => { if (entry.isIntersecting) { el.classList.add('visible'); } },
      { threshold: 0.12 }
    ).observe(el);
  });
</script>

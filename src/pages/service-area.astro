---
import Layout from '../layouts/Layout.astro';

const cities = [
  { name: "Grand Rapids", note: "Home base" },
  { name: "Ada", note: null },
  { name: "Caledonia", note: null },
  { name: "Cascade", note: null },
  { name: "Grandville", note: null },
  { name: "Holland", note: null },
  { name: "Kentwood", note: null },
  { name: "Lowell", note: null },
  { name: "Rockford", note: null },
  { name: "Walker", note: null },
];
---

<Layout
  title="Service Area — HealthyRoof | Greater Grand Rapids, MI"
  description="HealthyRoof serves homeowners across Greater Grand Rapids and West Michigan — including Ada, Cascade, Grandville, Holland, Kentwood, Rockford, Walker, Caledonia, and Lowell."
>

  <!-- ── Hero ── -->
  <section class="relative min-h-[56vh] flex items-center overflow-hidden bg-hr-cream">

    <div class="absolute inset-0 z-0">
      <img
        src="/images/Roof Replacement Drone Neighborhood shots (Thornquist 2025)/dji_fly_20250919_105810_0082_1758329182377_photo.JPG"
        alt="Aerial view of West Michigan neighborhood"
        class="w-full h-full object-cover object-center"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-hr-cream via-hr-cream/80 to-hr-cream/20"></div>
      <div class="absolute inset-0 bg-hr-text-primary/8"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 sm:px-10 lg:px-8 w-full py-20 lg:py-28">
      <div class="max-w-lg">

        <div class="flex items-center gap-3 mb-5 fade-up" style="animation-delay: 0ms;">
          <span class="h-px w-8 bg-hr-teal inline-block"></span>
          <span class="text-xs font-semibold uppercase tracking-widest text-hr-teal">Service Area</span>
        </div>

        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-hr-text-primary leading-[1.05] tracking-tight mb-5 fade-up" style="animation-delay: 80ms;">
          Proudly serving<br />
          <span class="text-hr-teal">West Michigan.</span>
        </h1>

        <p class="text-base sm:text-lg text-hr-text-secondary leading-relaxed mb-8 fade-up" style="animation-delay: 160ms;">
          We work with homeowners across Greater Grand Rapids and the surrounding communities — the same neighborhoods we live and work in every day.
        </p>

        <div class="flex flex-col sm:flex-row items-start gap-3 fade-up" style="animation-delay: 240ms;">
          <a
            href="/schedule"
            class="inline-flex items-center gap-2 bg-hr-teal hover:bg-hr-teal-dark text-white font-semibold text-sm px-6 py-3.5 rounded-full transition-all duration-200 shadow-md hover:shadow-lg group whitespace-nowrap"
          >
            Schedule a Roof Health Assessment
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          <a
            href="tel:6162851025"
            class="inline-flex items-center gap-2 text-hr-text-secondary hover:text-hr-teal font-medium text-sm transition-colors duration-200"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            Call or Text: 616.285.1025
          </a>
        </div>

        <p class="mt-3 text-xs text-hr-text-muted fade-up" style="animation-delay: 300ms;">
          Not sure if we cover your area? Give us a call — we're happy to help.
        </p>

      </div>
    </div>
  </section>

  <!-- ── Map + Cities ── -->
  <section class="bg-hr-stone py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">

        <!-- Map -->
        <div class="reveal-up">
          <div class="rounded-2xl overflow-hidden shadow-xl border border-hr-teal/10 aspect-[4/3]">
            <iframe
              title="HealthyRoof Service Area — Greater Grand Rapids, MI"
              src="https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d185000!2d-85.6681!3d42.9634!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!5e0!3m2!1sen!2sus!4v1716000000000!5m2!1sen!2sus"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              class="w-full h-full"
            ></iframe>
          </div>
          <p class="mt-3 text-xs text-hr-text-muted text-center">
            Serving Greater Grand Rapids & surrounding West Michigan communities
          </p>
        </div>

        <!-- Cities -->
        <div class="reveal-up" style="transition-delay: 0.1s;">
          <div class="flex items-center gap-3 mb-5">
            <span class="h-px w-8 bg-hr-teal inline-block"></span>
            <span class="text-xs font-semibold uppercase tracking-widest text-hr-teal">Communities We Serve</span>
          </div>
          <h2 class="font-display text-4xl sm:text-5xl font-bold text-hr-text-primary leading-[1.1] tracking-tight mb-4">
            Your neighbors.<br />
            <span class="text-hr-teal">Your roofers.</span>
          </h2>
          <p class="text-base text-hr-text-secondary leading-relaxed mb-8">
            We're not a national franchise dispatching crews from out of town. We live and work in these communities — and we're invested in keeping the homes here in great shape.
          </p>

          <div class="grid grid-cols-2 gap-3 mb-8">
            {cities.map((city) => (
              <div class="flex items-center gap-3 bg-white rounded-xl px-4 py-3 shadow-sm border border-hr-teal/8">
                <span class="w-2 h-2 rounded-full bg-hr-yellow shrink-0"></span>
                <div>
                  <p class="text-sm font-semibold text-hr-text-primary">{city.name}</p>
                  {city.note && (
                    <p class="text-xs text-hr-teal font-medium">{city.note}</p>
                  )}
                </div>
              </div>
            ))}
          </div>

          <div class="bg-white rounded-2xl px-5 py-4 border-l-4 border-hr-teal shadow-sm">
            <p class="text-sm font-medium text-hr-text-secondary leading-relaxed">
              Don't see your city? We may still be able to help. Give us a call at <a href="tel:6162851025" class="text-hr-teal font-semibold hover:text-hr-teal-dark transition-colors">616.285.1025</a> and we'll let you know.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── Why Local Matters ── -->
  <section class="bg-hr-teal py-20 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center max-w-2xl mx-auto mb-14 reveal-up">
        <div class="flex items-center justify-center gap-3 mb-5">
          <span class="h-px w-8 bg-hr-yellow/50 inline-block"></span>
          <span class="text-xs font-semibold uppercase tracking-widest text-hr-yellow">Why Local Matters</span>
          <span class="h-px w-8 bg-hr-yellow/50 inline-block"></span>
        </div>
        <h2 class="font-display text-4xl sm:text-5xl font-bold text-white leading-[1.1] tracking-tight mb-4">
          We know what West Michigan<br />
          <span class="text-hr-yellow">weather does to roofs.</span>
        </h2>
        <p class="text-base sm:text-lg text-white/70 leading-relaxed">
          Freeze-thaw cycles, heavy snow loads, ice dams, high winds, and humidity — West Michigan puts roofs through a lot. Knowing the local conditions means we catch the right things, at the right time.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 reveal-up" style="transition-delay: 0.1s;">
        {[
          {
            title: "Freeze-thaw cycles",
            desc: "Repeated freezing and thawing cracks flashing, lifts shingles, and opens gaps that let water in.",
          },
          {
            title: "Ice dams",
            desc: "Poor ventilation and insulation create ice dams that force water up under shingles and into your home.",
          },
          {
            title: "Heavy snow loads",
            desc: "Accumulated snow adds weight and moisture that stresses decking, gutters, and structural components.",
          },
          {
            title: "Wind-driven rain",
            desc: "West Michigan storms push water into vulnerable spots — around chimneys, vents, and valleys.",
          },
          {
            title: "Humidity & attic moisture",
            desc: "Warm, humid summers promote mold growth in poorly ventilated attics, quietly damaging your roof from inside.",
          },
          {
            title: "UV exposure & aging",
            desc: "Michigan's seasons accelerate shingle drying and granule loss — making timely rejuvenation or replacement critical.",
          },
        ].map((card) => (
          <div class="bg-white/10 border border-white/15 rounded-2xl p-6 hover:bg-white/15 transition-colors duration-200">
            <span class="w-2 h-2 rounded-full bg-hr-yellow inline-block mb-4"></span>
            <h3 class="font-display text-lg font-bold text-white mb-2">{card.title}</h3>
            <p class="text-sm text-white/70 leading-relaxed">{card.desc}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ── Final CTA ── -->
  <section class="py-20 lg:py-24 overflow-hidden relative">
    <div class="absolute inset-0" aria-hidden="true">
      <img
        src="/images/Roof Replacement Drone Neighborhood shots (Thornquist 2025)/dji_fly_20250919_105912_0086_1758329181256_photo.JPG"
        alt=""
        class="w-full h-full object-cover object-center"
      />
      <div class="absolute inset-0 bg-hr-teal-dark/90"></div>
    </div>

    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal-up">
      <div class="flex items-center justify-center gap-3 mb-5">
        <span class="h-px w-8 bg-hr-yellow/50 inline-block"></span>
        <span class="text-xs font-semibold uppercase tracking-widest text-hr-yellow">Serving Your Neighborhood</span>
        <span class="h-px w-8 bg-hr-yellow/50 inline-block"></span>
      </div>
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-white leading-[1.1] tracking-tight mb-4">
        We're right around<br />the corner.
      </h2>
      <p class="text-base text-white/65 leading-relaxed mb-8 max-w-xl mx-auto">
        Schedule a Roof Health Assessment and we'll come to you — with clear findings, honest guidance, and no pressure. Just a complete picture of where your roof stands.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/schedule"
          class="inline-flex items-center gap-2 bg-hr-yellow hover:bg-hr-yellow-dark text-hr-text-primary font-bold text-sm px-7 py-3.5 rounded-full transition-all duration-200 shadow-lg hover:shadow-xl group whitespace-nowrap"
        >
          Schedule Roof Health Assessment
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        <a
          href="tel:6162851025"
          class="inline-flex items-center gap-2 border border-white/30 hover:border-hr-yellow text-white hover:text-hr-yellow font-semibold text-sm px-7 py-3.5 rounded-full transition-all duration-200 whitespace-nowrap"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          616.285.1025
        </a>
      </div>
      <p class="mt-5 text-xs text-white/40">No pressure. No obligation. Just clear answers.</p>
    </div>
  </section>

</Layout>

<style>
  .fade-up {
    opacity: 0;
    transform: translateY(16px);
    animation: fadeUp 0.55s ease forwards;
  }
  @keyframes fadeUp {
    to { opacity: 1; transform: translateY(0); }
  }

  .reveal-up {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .reveal-up.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .dot-grid {
    background-image: radial-gradient(circle, #1A8A84 1px, transparent 1px);
    background-size: 18px 18px;
  }
</style>

<script>
  document.querySelectorAll('.reveal-up').forEach((el) => {
    new IntersectionObserver(
      ([entry]) => { if (entry.isIntersecting) { el.classList.add('visible'); } },
      { threshold: 0.12 }
    ).observe(el);
  });
</script>

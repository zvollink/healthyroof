---
import Layout from '../layouts/Layout.astro';

const lastUpdated = "August 23, 2026";
const address = "2059 Breton Road SE, Grand Rapids, MI 49546";
const phone = "616-284-1925";
const phoneHref = "tel:6162841925";
const email = "info@thehealthyroof.com";
---

<Layout
  title="Terms of Service — Healthy Roof | Grand Rapids, MI"
  description="Terms of Service for the Healthy Roof website — please read these terms before using our site or requesting a roofing estimate."
>

  <!-- ── Header ── -->
  <section class="bg-hr-stone py-16 lg:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-xs font-semibold uppercase tracking-widest text-hr-text-primary bg-hr-yellow px-3 py-1 rounded-full">Legal</span>
      </div>
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-hr-text-primary leading-[1.1] tracking-tight mb-4">
        Terms of Service
      </h1>
      <p class="text-sm text-hr-text-secondary">Effective Date: {lastUpdated}</p>
    </div>
  </section>

  <!-- ── Content ── -->
  <section class="bg-hr-cream py-16 lg:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-hr-text-secondary leading-relaxed">

      <p class="mb-6">
        Welcome to thehealthyroof.com (the "Site"), operated by Simple Companies, LLC, doing business
        as Healthy Roof ("Healthy Roof," "we," "us," or "our"). By accessing or using this Site,
        requesting an estimate, or communicating with us by phone, text/SMS, or chat, you agree to
        these Terms of Service ("Terms"). If you do not agree, please do not use this Site.
      </p>

      <h2 class="font-display text-2xl font-bold text-hr-text-primary mt-10 mb-3">1. Who We Are</h2>
      <p class="mb-3">Healthy Roof is a roofing services business operated by Simple Companies, LLC.</p>
      <ul class="list-disc pl-5 space-y-2 mb-4">
        <li><span class="font-semibold text-hr-text-primary">Business Address:</span> {address}</li>
        <li><span class="font-semibold text-hr-text-primary">Support Email:</span> <a href={`mailto:${email}`} class="text-hr-teal hover:text-hr-teal-dark font-medium">{email}</a></li>
        <li><span class="font-semibold text-hr-text-primary">Phone:</span> <a href={phoneHref} class="text-hr-teal hover:text-hr-teal-dark font-medium">{phone}</a></li>
      </ul>

      <h2 class="font-display text-2xl font-bold text-hr-text-primary mt-10 mb-3">2. Services</h2>
      <p class="mb-4">
        Healthy Roof provides roofing inspection, repair, replacement, and related services. Instant
        estimates provided through the Site (including our Roofle-powered estimate tool) are
        preliminary only. Instant quote pricing is subject to measurement and/or site verification, and
        final pricing will be confirmed after an in-person or virtual assessment.
      </p>

      <h2 class="font-display text-2xl font-bold text-hr-text-primary mt-10 mb-3">3. Communications &amp; SMS/Text Messaging Consent</h2>
      <p class="mb-3">
        By submitting your phone number through our Site, chat widget, or estimate form, you may
        receive calls and text messages from Healthy Roof, including messages sent by automated systems
        and AI-assisted chat or voice tools, regarding your estimate request, appointment scheduling,
        and customer service.
      </p>
      <ul class="list-disc pl-5 space-y-2 mb-4">
        <li>Message frequency varies.</li>
        <li>Message and data rates may apply.</li>
        <li>Reply <span class="font-semibold text-hr-text-primary">STOP</span> at any time to opt out of text messages. Reply <span class="font-semibold text-hr-text-primary">HELP</span> for assistance.</li>
        <li>Consent to receive text messages is not a condition of purchasing any services.</li>
        <li>We do not sell or share your mobile phone number or opt-in consent with third parties for their own marketing purposes.</li>
      </ul>

      <h2 class="font-display text-2xl font-bold text-hr-text-primary mt-10 mb-3">4. User Conduct</h2>
      <p class="mb-4">
        You agree not to misuse the Site, including by submitting false information, attempting to
        interfere with the Site's operation, or using the Site for any unlawful purpose.
      </p>

      <h2 class="font-display text-2xl font-bold text-hr-text-primary mt-10 mb-3">5. Third-Party Tools</h2>
      <p class="mb-4">
        Our Site uses third-party service providers to operate certain features, including but not
        limited to instant estimate tools, chat and SMS/voice communication platforms, and appointment
        scheduling. Use of these tools is also subject to those providers' own terms where applicable.
      </p>

      <h2 class="font-display text-2xl font-bold text-hr-text-primary mt-10 mb-3">6. Disclaimers</h2>
      <p class="mb-4">
        The Site and its content, including instant estimates, are provided "as is" without warranties
        of any kind. Estimates generated through automated tools are not final quotes and are subject
        to change following an in-person inspection.
      </p>

      <h2 class="font-display text-2xl font-bold text-hr-text-primary mt-10 mb-3">7. Limitation of Liability</h2>
      <p class="mb-4">
        To the fullest extent permitted by law, Healthy Roof and Simple Companies, LLC shall not be
        liable for any indirect, incidental, or consequential damages arising from your use of the
        Site.
      </p>

      <h2 class="font-display text-2xl font-bold text-hr-text-primary mt-10 mb-3">8. Governing Law</h2>
      <p class="mb-4">
        These Terms are governed by the laws of the State of Michigan, without regard to conflict of
        law principles.
      </p>

      <h2 class="font-display text-2xl font-bold text-hr-text-primary mt-10 mb-3">9. Changes to These Terms</h2>
      <p class="mb-4">
        We may update these Terms from time to time. Continued use of the Site after changes are posted
        constitutes acceptance of the revised Terms.
      </p>

      <h2 class="font-display text-2xl font-bold text-hr-text-primary mt-10 mb-3">10. Contact Us</h2>
      <p class="mb-3">Questions about these Terms can be sent to:</p>
      <p class="mb-1 font-semibold text-hr-text-primary">Simple Companies, LLC d/b/a Healthy Roof</p>
      <p class="mb-1">{address}</p>
      <p class="mb-1">Email: <a href={`mailto:${email}`} class="text-hr-teal hover:text-hr-teal-dark font-medium">{email}</a></p>
      <p class="mb-4">Phone: <a href={phoneHref} class="text-hr-teal hover:text-hr-teal-dark font-medium">{phone}</a></p>

    </div>
  </section>

</Layout>
